DECLARE
    V_NAME VARCHAR2(50) := 'Pankaj';
    V_SALARY NUMBER(10,2);
BEGIN
    V_SALARY := 50000.342;

    DBMS_OUTPUT.PUT_LINE(V_NAME);

    DBMS_OUTPUT.PUT_LINE('Salary of ' || V_NAME || ' is: ' || V_SALARY);

    DBMS_OUTPUT.PUT_LINE(V_SALARY * 12);

    DBMS_OUTPUT.PUT_LINE(V_SALARY * 0.5);
END;
/

